# Copiar para .env.local e preencher (não commitar segredos)

STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tour IDs → price_... ou prod_...
STRIPE_PRICE_MAP={"sintra-cascais":"prod_xxx","3-destinos":"prod_xxx","lisboa":"prod_xxx","porto":"prod_xxx","arraabida":"prod_xxx","alentejo":"prod_xxx","algarve":"prod_xxx"}

# --- Webhook Stripe (obrigatório para Google Calendar após pagamento) ---
# Stripe → Developers → Webhooks → Add endpoint
# URL: https://SEU_DOMINIO/api/webhooks/stripe
# Evento: checkout.session.completed
# Copia o "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# --- Google Calendar (conta de serviço) ---
# 1) Google Cloud Console → API e serviços → Biblioteca → ativar "Google Calendar API"
# 2) IAM → Contas de serviço → Criar → JSON → copia client_email e private_key
# 3) Google Calendar (web) → Criar calendário "Reservas" (ou usar um existente)
#    → Definições do calendário → Partilhar com o client_email da conta de serviço
#    → Permissão: "Fazer alterações aos eventos"
# 4) ID do calendário: Definições → "ID do calendário" (ex.: xxx@group.calendar.google.com)
#
# A chave privada no .env: mantém \n como quebras de linha ou usa uma linha com \\n
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
