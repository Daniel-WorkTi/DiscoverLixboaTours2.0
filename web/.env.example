# Copiar para .env.local (local) ou variáveis na Vercel (produção).
# NUNCA coloques chaves reais neste ficheiro — só exemplos.

STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Tour IDs → price_... ou prod_... (JSON numa linha)
STRIPE_PRICE_MAP={"sintra-cascais":"prod_xxx","3-destinos":"prod_xxx"}

# Webhook Stripe (produção: signing secret do endpoint na Vercel)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Google Calendar (service account)
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# Dashboard /admin (login)
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Notificação por email em cada reserva paga (Resend — https://resend.com )
RESEND_API_KEY=re_xxxxxxxx
BOOKING_NOTIFY_EMAIL=teu-email@exemplo.com
# Opcional: domínio verificado na Resend
# RESEND_FROM_EMAIL="Discover Lixboa <noreply@seudominio.com>"
