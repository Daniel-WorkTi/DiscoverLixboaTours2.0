# Fonte de verdade em produção: Vercel → Project → Settings → Environment Variables
# (Production / Preview / Development conforme precisares.)
#
# Desenvolvimento local (opcional): copia este ficheiro para .env.local e preenche.
# NUNCA coloques chaves reais neste ficheiro — só exemplos.

STRIPE_SECRET_KEY=sk_test_xxxxxxxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Forçar refresh de assets no browser/Next Image (muda este valor quando atualizares imagens)
NEXT_PUBLIC_ASSET_VERSION=1
# Galeria /executive (horiontal1, horizontal2, vertical) — incrementa ao substituir PNGs
# NEXT_PUBLIC_EXEC_SHOWCASE_IMG_V=2

# Página /executive — ID do vídeo YouTube (predefinição iTHiv1ETxQw se omitido)
# NEXT_PUBLIC_EXECUTIVE_YOUTUBE_ID=iTHiv1ETxQw

# Secção Mobilidade — imagem central (caminho em /public; predefinição famili.png)
# NEXT_PUBLIC_EXEC_TRANSFERS_VISUAL=/assets/images/executive/famili.png
# Ao substituir a imagem com o mesmo nome, incrementa para limpar cache (browser / Next Image)
# NEXT_PUBLIC_EXEC_TRANSFERS_IMG_V=2

# Tour IDs → price_... (JSON numa linha). Preferir Price ID, não prod_...
STRIPE_PRICE_MAP={"sintra-cascais":"price_xxx","3-destinos":"price_xxx"}

# Webhook Stripe (signing secret do endpoint)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Google Calendar (service account)
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# Dashboard /admin (login)
ADMIN_PASSWORD=
ADMIN_AUTH_SECRET=

# Notificação por email em cada reserva paga (Resend — https://resend.com )
RESEND_API_KEY=re_xxxxxxxx
BOOKING_NOTIFY_EMAIL=teu-email@exemplo.com
# Opcional: domínio verificado na Resend
# RESEND_FROM_EMAIL="Discover Lixboa <noreply@seudominio.com>"
