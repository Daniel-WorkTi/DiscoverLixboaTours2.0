# Copiar para .env.local (local) ou variáveis na Vercel (produção).
# NUNCA coloques chaves reais neste ficheiro — só exemplos. O .env.local não vai para o Git.
# Na Vercel: cola o valor sem aspas à volta; marca Production (e Preview se precisares).

STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# URL pública do site (recomendado com domínio próprio; a Vercel define VERCEL_URL mas podes forçar aqui).
# Ex.: https://teu-projeto.vercel.app ou o domínio customizado — evita success_url em localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp (E.164 sem +), ex.: 351934483853 — página Obrigado e links wa.me
# NEXT_PUBLIC_WHATSAPP_E164=351934483853

# Tour IDs → price_... ou prod_... (JSON numa linha)
# Pode ser 1 preço por tour (string) OU preços por quantidade (objeto com chaves tipo "2", "3-4", "5-7").
# Exemplo:
# STRIPE_PRICE_MAP={"sintra-cascais":{"2":"price_xxx","3-4":"price_yyy","5-7":"price_zzz"},"lisboa":"price_xxx"}
STRIPE_PRICE_MAP={"sintra-cascais":"prod_xxx","3-destinos":"prod_xxx","monsanto":"prod_xxx","lisboa":"prod_xxx","porto":"prod_xxx","arraabida":"prod_xxx","aveiro":"prod_xxx","alentejo":"prod_xxx","algarve":"prod_xxx"}

# Webhook Stripe — copia o signing secret do Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# Google Calendar — ver comentários no README ou documentação interna
GOOGLE_CALENDAR_ID=xxxx@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=nome@projeto.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"

# Email ao dono em cada reserva (Resend — https://resend.com ). Webhook Stripe dispara o envio.
RESEND_API_KEY=re_dgfjsZ2m_3dXrkmdXXyxZzsT44zuPwDiF
BOOKING_NOTIFY_EMAIL=websitediscoverlixboatours@gmail.com
# Opcional: domínio verificado na Resend; senão usa o remetente de teste da Resend.
# RESEND_FROM_EMAIL="Discover Lixboa <noreply@seudominio.com>"
